{
  "name": "cwpc-bad-electronic-grading",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --project=visual",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:push": "supabase db push",
    "supabase:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "supabase:functions": "supabase functions serve",
    "supabase:deploy": "supabase functions deploy",
    "taste:deal:layout": "node .taste-skill/assets/layout/deal.mjs --type software --has ui --history .taste-skill/layout-history.json",
    "taste:deal:palette": "node .taste-skill/scripts/start.mjs deal --page software --history .taste-skill/history.json",
    "taste:build:css": "node .taste-skill/scripts/start.mjs css --page software --palette",
    "taste:consistency": "node .taste-skill/scripts/consistency.mjs",
    "taste:check": "node .taste-skill/assets/layout/check.mjs",
    "taste:perf": "node .taste-skill/scripts/perf.mjs",
    "taste:shoot": "node .taste-skill/scripts/shoot.mjs",
    "taste:icons": "node .taste-skill/scripts/icons.mjs scan",
    "db:studio": "supabase studio"
  },
  "dependencies": {
    "next": "15.0.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
