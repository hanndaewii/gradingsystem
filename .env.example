# Copy to .env and fill in. Only VITE_* vars reach the browser.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx

# Server-side only — never expose these to the browser or to Cloudflare build vars.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@POOLER_HOST:6543/postgres
DATABASE_URL_DIRECT=postgresql://postgres:PROJECT:PASSWORD@DB_HOST:5432/postgres
