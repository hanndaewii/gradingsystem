# Supabase Configuration
# Get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Key - NEVER expose this client-side!
# Get from Supabase project settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="CWPC BAD Electronic Grading System"

# Authentication
NEXT_PUBLIC_AUTH_REDIRECT_URL=http://localhost:3000/auth/callback
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-auth-secret-here

# Database (for server-side operations)
# Local Supabase: postgresql://postgres:postgres@localhost:54322/postgres
# Production: Get from Supabase project settings > Database > Connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Email (Resend)
# Get from https://resend.com/api-keys
EMAIL_FROM=noreply@yourdomain.com
RESEND_API_KEY=re_your-resend-api-key

# File Storage
NEXT_PUBLIC_STORAGE_BUCKET=grading-assets
SUPABASE_STORAGE_URL=https://your-project-id.supabase.co/storage/v1

# Analytics (Optional)
# Google Analytics 4 Measurement ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# Vercel Analytics
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=

# Feature Flags
NEXT_PUBLIC_ENABLE_AI_GRADING=false
NEXT_PUBLIC_ENABLE_BULK_UPLOAD=true
NEXT_PUBLIC_ENABLE_EXPORT_PDF=true

# Development
NODE_ENV=development